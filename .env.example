# Copier vers .env et ajuster.
# Next.js écoute sur le port 3002 (scripts npm dev / start). Pour surcharger : PORT=3002
# Créer la base : CREATE DATABASE pointage CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;

# MySQL — base `pointage` (utilisateur / mot de passe / hôte à adapter)
# Docker local : docker compose up -d  puis :
# DATABASE_URL="mysql://root:root@localhost:3306/pointage"
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/pointage"

# Migrations Prisma (créer la base vide puis) :
#   npm run db:migrate        # développement : applique + crée de nouvelles migrations
#   npm run db:migrate:deploy # production / CI : applique uniquement les migrations en attente
# Si les tables existaient déjà sans historique Migrate, baseliner la première migration :
#   npx prisma migrate resolve --applied "20250504120000_init_pointage_mysql"

# NextAuth JWT (minimum 32 caractères en production)
AUTH_SECRET="change-me-to-a-long-random-secret-at-least-32chars"
NEXTAUTH_URL="http://localhost:3002"

# Microsoft Entra ID (connexion OAuth managers / SSO)
# AZURE_AD_TENANT_ID=
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
# Optionnel : mapping rôles par email (séparés par virgule)
# AZURE_DG_EMAILS=dg@organisation.local
# AZURE_ASSISTANT_EMAILS=assistante@organisation.local
# AZURE_EXTERNAL_DOMAINS=partenaire.com

# Import annuaire Microsoft Entra ID (Graph — permission application User.Read.All)
# Utilise GRAPH_* ou les mêmes variables que AZURE_AD_*
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=

# LDAP / Active Directory on-premise (import utilisateurs)
# LDAP_BIND_PASSWORD=secret-liaison-ldap

# Microsoft Graph (calendrier Outlook DG — app-only)
# Permissions application : Calendars.ReadWrite, OnlineMeetings.ReadWrite.All (réunions Teams)
# GRAPH_TENANT_ID=   (souvent identique à AZURE_AD_TENANT_ID)
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# DG_OUTLOOK_EMAIL=dg@organisation.com

# SMTP (notifications email)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Cabinet DG <noreply@organisation.local>"

# Cron rappels (POST /api/cron/reminders)
# CRON_SECRET=change-me-cron-secret

# Fuseau pour la journée de travail et les retards
ATTENDANCE_TIMEZONE="Africa/Conakry"

# Minutes après l'heure prévue d'entrée avant de compter un absent
ATTENDANCE_ABSENT_GRACE_MINUTES=45

# Mot de passe seed (optionnel, défaut: password123)
# SEED_PASSWORD=

# Notifications (providers reels)
# Email via Resend (prioritaire si configure)
# RESEND_API_KEY="re_xxx"
# RESEND_FROM_EMAIL="ESMT <no-reply@votre-domaine.com>"
#
# SMS via Twilio (prioritaire si configure)
# TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_AUTH_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_FROM_NUMBER="+221700000000"
#
# Fallback webhook (si vous n'utilisez pas Resend/Twilio)
# NOTIFICATION_EMAIL_WEBHOOK="https://votre-endpoint/email"
# NOTIFICATION_SMS_WEBHOOK="https://votre-endpoint/sms"

# Mode démo sans MySQL (auth + calendrier en mémoire). Avec MySQL : "false"
# Emails de bienvenue réels : USE_MOCK_DATA=false, NEXT_PUBLIC_USE_MOCK_DATA=false, redémarrer,
# puis SMTP (hôte + expéditeur) dans Administration → Paramètres.
USE_MOCK_DATA="false"
# NEXT_PUBLIC_USE_MOCK_DATA="false"

# Après configuration DATABASE_URL :
#   npm run db:migrate
#   npm run db:seed

# Accès direct aux pages / API sans connexion (auto avec USE_MOCK_DATA)
# DISABLE_AUTH="true"
# NEXT_PUBLIC_DISABLE_AUTH="true"

# Assistant IA (optionnel — sans clé, mode assisté basé sur les données réelles)
# OPENAI_API_KEY="sk-..."
# AI_MODEL="gpt-4o-mini"

# Landing — vidéo « Voir le workflow » (MP4 local ou URL YouTube/Vimeo)
# NEXT_PUBLIC_LANDING_WORKFLOW_VIDEO_URL="/videos/workflow-dga.mp4"
